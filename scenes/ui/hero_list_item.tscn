[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/ui/hero_list_item.gd" id="1_item"]

[sub_resource type="Shader" id="Shader_portrait"]
code = "shader_type canvas_item;\n\nuniform vec4 border_color : source_color = vec4(0.36, 0.67, 1.0, 1.0);\nuniform float border_width = 0.025;\nuniform float art_scale = 0.80;\nuniform float hover_amount = 0.0;\n\nvoid fragment() {\n\tvec2 centered = UV - vec2(0.5);\n\tfloat distance_from_center = length(centered);\n\tfloat outer_radius = 0.46;\n\tfloat inner_radius = outer_radius - border_width;\n\tfloat aa = max(fwidth(distance_from_center) * 1.25, 0.001);\n\n\tfloat outer_coverage = 1.0 - smoothstep(outer_radius - aa, outer_radius + aa, distance_from_center);\n\tfloat inner_coverage = 1.0 - smoothstep(inner_radius - aa, inner_radius + aa, distance_from_center);\n\tfloat border_coverage = clamp(outer_coverage - inner_coverage, 0.0, 1.0);\n\tfloat glow_alpha = (1.0 - smoothstep(outer_radius, 0.5, distance_from_center)) * hover_amount * 0.45;\n\n\tvec2 art_uv = centered / art_scale + vec2(0.5);\n\tart_uv = clamp(art_uv, vec2(0.0), vec2(1.0));\n\tvec4 art = texture(TEXTURE, art_uv);\n\tvec3 art_rgb = mix(vec3(1.0), art.rgb, art.a);\n\n\tvec3 circle_rgb = mix(art_rgb, border_color.rgb, border_coverage);\n\tfloat circle_alpha = max(inner_coverage, border_coverage);\n\tvec3 final_rgb = mix(border_color.rgb, circle_rgb, circle_alpha);\n\tfloat final_alpha = max(circle_alpha, glow_alpha);\n\tCOLOR = vec4(final_rgb, final_alpha);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_portrait"]
resource_local_to_scene = true
shader = SubResource("Shader_portrait")

