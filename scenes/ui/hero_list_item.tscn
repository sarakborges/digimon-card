[sub_resource type="Shader" id="Shader_portrait"]
code = "shader_type canvas_item;\n\nuniform vec4 border_color : source_color = vec4(0.06, 0.08, 0.11, 1.0);\nuniform float border_width = 0.055;\n\nvoid fragment() {\n\tvec2 centered = UV - vec2(0.5);\n\tfloat dist = length(centered);\n\tif (dist > 0.5) {\n\t\tdiscard;\n\t}\n\n\tif (dist > 0.5 - border_width) {\n\t\tCOLOR = border_color;\n\t} else {\n\t\tCOLOR = texture(TEXTURE, UV);\n\t}\n}\n"

